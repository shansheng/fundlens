node_modules/

# Rust build artifacts (large, generated)
target/

# Frontend / Tauri build output
dist/
dist-arm64/
dist-android/

# Local databases — runtime user data (持仓等隐私), NOT source
*.db
*.db.bak
*.db.bak2

# macOS
.DS_Store

# TypeScript build info
*.tsbuildinfo

# Dev run artifacts (launchd agent / runtime logs) — local only, never ship
com.fundlens.dev.plist
run-dev.sh
dev.log
dev.err.log
build.log

# Vite 构建临时文件
*.timestamp-*.mjs

# 发版二进制产物不进 git（本地留存即可）
*.apk
*.idsig
*.app.tar.gz
# 注：fl-build-android.sh 已入库（2026-11-07）。此前因含 keystore 密码明文被忽略，
# 导致换机后脚本缺失、路径全失效。现密码改由 ~/.gradle/gradle.properties 提供，可安全跟踪。
# keystore 本体与其他签名材料永远不进仓库。
*.keystore
*.jks
