{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FundLens 默认能力：允许核心 API 与全部自定义命令",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fl-get-overview",
    "fl-get-fund-detail",
    "fl-get-stats",
    "fl-import-screenshots",
    "fl-refresh-quotes",
    "fl-add-fund",
    "fl-update-position",
    "fl-delete-fund",
    "fl-list-disclosures",
    "fl-fetch-disclosure",
    "fl-fetch-all-disclosures",
    "fl-fetch-quotes",
    "fl-read-image-data-url",
    "fl-import-txn-screenshots",
    "fl-list-transactions",
    "fl-add-transaction",
    "fl-delete-transaction",
    "fl-import-transactions",
    "fl-refresh-nav-history",
    "fl-get-fund-series",
    "fl-get-weekly-report",
    "fl-get-monthly-report",
    "fl-get-pnl-calendar"
  ]
}
